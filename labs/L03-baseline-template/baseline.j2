hostname {{ hostname }}
!
banner motd ^C
{{ banner_message }}
^C
!
ip domain-name {{ domain_name }}
crypto key generate rsa modulus 2048
ip ssh version 2
!
line vty 0 4
 transport input ssh
 login local
!
logging host {{ syslog_server }}
ntp server {{ ntp_server }}
!
no ip http server
no ip http secure-server
no cdp run
!
end

